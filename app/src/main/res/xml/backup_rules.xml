<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup exclusion rules for Android 11 (API 30) and below.
    For API 31+, see data_extraction_rules.xml.

    CRITICAL: Vault media and keys must NEVER leave the device via backup.
-->
<full-backup-content>
    <!-- Encrypted media files -->
    <exclude domain="file" path="vault/" />
    <exclude domain="file" path="thumbs/" />
    <exclude domain="file" path="tmp/" />

    <!-- Room database (contains encrypted key bundles + metadata) -->
    <exclude domain="database" path="vault_database" />
    <exclude domain="database" path="vault_database-shm" />
    <exclude domain="database" path="vault_database-wal" />

    <!-- DataStore preferences (security state, lock settings) -->
    <exclude domain="file" path="datastore/" />

    <!-- Shared prefs fallback -->
    <exclude domain="sharedpref" path="." />
</full-backup-content>
